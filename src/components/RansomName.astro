---
interface Props {
  name: string;
}

const { name } = Astro.props;
const letters = [...name];
const flyer = name.toUpperCase() === "NOMBRE";

function letterClass(letter: string, index: number) {
  const glyph = letter.toUpperCase();
  if (flyer) {
    return {
      hot: glyph === "B",
    };
  }
  return {
    invert: index === 0 || glyph === "N",
    hot: glyph === "R" || glyph === "E" || glyph === "B",
  };
}
---

<h1 class="ransom scrap-in" aria-label={name} style="--d:40">
  {
    letters.map((letter, i) =>
      letter === " " ? (
        <span class="space" aria-hidden="true"></span>
      ) : (
        <span
          class:list={[letterClass(letter, i), i === 2 && "display"]}
          style={`--i:${i}; --rot:${(i % 5) - 2}deg`}
        >
          {letter}
        </span>
      )
    )
  }
</h1>
