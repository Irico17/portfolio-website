---
interface Props {
  word: string;
  invertLast?: boolean;
}

const { word, invertLast = true } = Astro.props;
const letters = [...word];
const last = letters.length - 1;
---

<span class="cut-word scrap-in" aria-hidden="true" style="--d:200">
  {
    letters.map((letter, i) => (
      <span class:list={[{ invert: invertLast && i === last, tape: letter.toUpperCase() === "A" && i === 2 }]} style={`--i:${i}`}>
        {letter}
      </span>
    ))
  }
</span>
